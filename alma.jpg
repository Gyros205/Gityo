        border-radius: 4px;
    }

    #dijkalkulator .input-wrapper {
        position: relative;
    }

    #dijkalkulator .input-wrapper svg {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
    }

    #dijkalkulator button {
        margin-top: 1rem;
