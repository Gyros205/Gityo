		</div><div id="div_block-40-191" class="ct-div-block" ><div id="div_block-42-191" class="ct-div-block termek_info_price" ><div id="text_block-43-191" class="ct-text-block termek_price" ><span id="span-44-191" class="ct-span" >740 Ft</span><br></div><div id="text_block-45-191" class="ct-text-block termek_og_price" ><span id="span-46-191" class="ct-span" ><del>990 Ft</del></span><br></div><div id="text_block-47-191" class="ct-text-block termek_akcio" ><span id="span-48-191" class="ct-span" >- 25%</span><br></div></div></div><div id="code_block-404-191" class="ct-code-block" ><style id="sg-hide-cart">
	/* Külső wrapper – egymás alatti elemek */
	.sg-zip-wrapper{
		display:flex;
		flex-direction:column;
		gap:8px;
		width:100%;
	}

	/* Belső sor – input + gomb egy sorban */
	.sg-zip-row{
		display:flex;
		align-items:center;
		gap:8px;
	}

	/* input */
	.sg-zip-row input{
		flex:1 1 200px;
		font-size:20px;
		font-weight:700;
		border-radius:4px;
		padding:14px 12px!important;
		border:1px solid rgb(240 238 229);
		box-sizing:border-box;
        max-width: 207px;
	}

	/* gomb */
	.sg-zip-row button{
		padding:14px 26px;
		border-radius:30px;
		font-weight:700;
		border:2px solid #3aaa35;
		background:#3aaa35;
		color:#fff;
		cursor:pointer;
		transition:.3s;
		white-space:nowrap;
	}
	.sg-zip-row button:hover{ background:#8ac494; }

	/* hibaüzenet */
	.sg-zip-error{ color:#d00;font-size:.875rem;display:none; }

	/* Kosárgomb rejtése → JS törli a style taget */
	.termek-kosarba{ display:none !important; }
</style>

<div class="sg-zip-wrapper">
	<div class="sg-zip-row">
		<input type="text" id="sg-zip" maxlength="4" inputmode="numeric" pattern="\d{4}"
		       placeholder="Adja meg az irányítószámát">
		<button type="button" id="sg-zip-check">Ellenőrzés</button>
	</div>
	<div class="sg-zip-error" id="sg-zip-error">
		Sajnos a megadott irányítószámra friss gyümölcsöt nem szállítunk.
	</div>
</div>

<script>
(function(){
	const allowed  = ["1011","1012","1013","1014","1015","1016","1020","1021","1022","1023","1024","1025","1026","1027","1028","1029","1030","1031","1032","1033","1034","1035","1036","1037","1038","1039","1041","1042","1043","1044","1045","1046","1047","1048","1051","1052","1053","1054","1055","1056","1060","1061","1062","1063","1064","1065","1066","1067","1068","1069","1070","1071","1072","1073","1074","1075","1076","1077","1078","1080","1081","1082","1083","1084","1085","1086","1087","1088","1089","1091","1092","1093","1094","1095","1096","1097","1098","1101","1102","1103","1104","1105","1106","1107","1108","1110","1111","1112","1113","1114","1115","1116","1117","1118","1119","1120","1121","1122","1123","1124","1125","1126","1130","1131","1132","1133","1134","1135","1136","1137","1138","1139","1140","1141","1142","1143","1144","1145","1146","1147","1148","1149","1151","1152","1153","1154","1155","1156","1157","1158","1161","1162","1163","1164","1165","1171","1172","1173","1174","1180","1181","1182","1183","1184","1185","1186","1188","1191","1192","1193","1194","1195","1196","1201","1202","1203","1204","1205","1208","1211","1212","1213","1214","1215","1221","1222","1223","1224","1225","1237","1238","1239","2000","2011","2019","2030","2031","2032","2033","2035","2036","2038","2040","2041","2042","2043","2044","2045","2046","2047","2049","2050","2052","2055","2056","2092","2094","2096","2100","2101","2102","2103","2105","2111","2112","2113","2114","2115","2116","2117","2118","2119","2120","2121","2122","2123","2131","2132","2133","2134","2135","2141","2142","2143","2144","2145","2146","2151","2152","2153","2161","2170","2173","2174","2181","2182","2183","2184","2191","2192","2193","2194","2200","2201","2202","2209","2211","2212","2213","2214","2215","2216","2217","2220","2221","2222","2225","2230","2233","2234","2235","2241","2242","2243","2244","2251","2252","2253","2254","2255","2301","2309","2310","2311","2313","2314","2315","2316","2317","2318","2330","2331","2332","2335","2336","2341","2342","2351","2360","2363","2364","2374","2376","2378","2440","2441","2442","2443","2444","2451","2453","2461","2462","2465","2601","2602","2603","2619","2700","2701","2702","2703","2704","2711","2721","2723","2724","2730","2735","2738","2740","2747","2760","2761","2764","2765","2766","2767","2768","2769","3000","3001","3002","3003","3009","3011","3012","3013","3014","3015","3016","3021","3022","3023","3024","3031","3032","3033","3034","3035","3036","3041","3042","3043","3046","3051","3200","3201","3202","3211","3212","3213","3214","3221","3231","3232","3233","3256","3261","3262","3263","3264","3265","3271","3272","3273","3274","3275","3281","3282","3283","3284","3291","3292","3293","3294","3295","3296","3300","3301","3302","3303","3304","3305","3324","3325","3326","3327","3328","3331","3350","3351","3352","3353","3354","3355","3356","3357","3358","3359","3360","3368","3369","3390","3392","3393","3394","3395","3396","3397","3398","3399","3400","3401","3402","3411","5000","5001","5002","5003","5004","5005","5006","5007","5008","5009","5051","5052","5053","5054","5055","5081","5100","5101","5102","5111","5121","5122","5123","5124","5125","5126","5130","5131","5135","5136","5137","5141","5142","5143","5144","5152","5200","5201","5211","5212"];
	const cartBtn  = document.querySelector('.termek-kosarba');
	const zipInput = document.getElementById('sg-zip');
	const checkBtn = document.getElementById('sg-zip-check');
	const errMsg   = document.getElementById('sg-zip-error');
	const styleTag = document.getElementById('sg-hide-cart');
	const wrapper  = document.querySelector('.sg-zip-wrapper');

	if(!zipInput || !checkBtn){ return; }

	// Csak számjegyet engedünk a bevitelnél
	zipInput.addEventListener('input', () => {
		zipInput.value = zipInput.value.replace(/\D+/g, '').slice(0,4);
	});

	function validate(){
		const zip = (zipInput.value || '').trim();
		// 4 számjegy ellenőrzés
		if(!/^\d{4}$/.test(zip)){
			errMsg.textContent = 'Kérjük, 4 számjegyű irányítószámot adjon meg.';
			errMsg.style.display = 'block';
			return;
		}

		if( Array.isArray(allowed) && allowed.includes(zip) ){
			errMsg.style.display = 'none';
			if(styleTag){ styleTag.remove(); }          // visszahozza a kosárgombot
			if(cartBtn){ cartBtn.style.display = ''; }
			if(wrapper){ wrapper.style.display = 'none'; }  // elrejtjük az ellenőrzőt
		}else{
			errMsg.textContent = 'Sajnos a megadott irányítószámra friss gyümölcsöt nem szállítunk.';
			errMsg.style.display = 'block';
		}
	}

	checkBtn.addEventListener('click', validate);
	zipInput.addEventListener('keydown', e=>{
		if(e.key==='Enter'){ e.preventDefault(); validate(); }
	});
})();
</script>
</div>
		<div id="-product-cart-button-49-191" class="oxy-product-cart-button termek-kosarba oxy-woo-element" >
	
	<form class="cart" action="https://simongyumolcs.hu/termek/alma-idared-apro-1kg/" method="post" enctype='multipart/form-data'>
		
		<div class="quantity">
		<label class="screen-reader-text" for="quantity_698471d8ee6f5">Idared Alma - 1 kg mennyiség</label>
	<input
		type="number"
				id="quantity_698471d8ee6f5"
		class="input-text qty text"
		name="quantity"
		value="1"
		aria-label="Termék mennyiség"
				min="1"
							step="1"
			placeholder=""
			inputmode="numeric"
			autocomplete="off"
			/>
	</div>

		<button type="submit" name="add-to-cart" value="1152589" class="single_add_to_cart_button button alt">Kosárba teszem</button>

		
        <script>
            document.addEventListener('DOMContentLoaded', function(){
                document.addEventListener('click', function(event){
                    if(!event.target.matches('.single_add_to_cart_button')){
                        return;
                    }

                    const quantity = document.querySelector('input.qty').value || '1';
                    const formProductVariation = document.querySelector('form[data-product_variations]')
                    const variationItem = document.querySelector('.variation_id')

                    let price = 740
                    if(formProductVariation && variationItem){
                        try{
                            const variations = JSON.parse(formProductVariation.dataset.product_variations)
                            const variationId = variationItem.value
                            for(const variation of variations){
                                if(variation.variation_id == Number(variationId)){
                                    price = variation.display_price
                                }
                            }
                        }
                        catch{
                        }
                    }

                    gtag('event', 'add_to_cart', {
                        'items': [ {
                            'item_id':'Idared',
                            'item_name': 'Idared Alma - 1 kg',
                            'list_name': 'Idared Alma - 1 kg',
                            'quantity': quantity,
                            'price': price,
                            "item_category":"Friss gyümölcsök"
                        }]
                    });
                })
            });
        </script>
        	</form>

	
</div>

		<div id="div_block-455-191" class="ct-div-block dijkalkulator-button" ><img  id="image-459-191" alt="" src="https://simongyumolcs.hu/wp-content/uploads/2025/09/simon_kalkulator.svg" class="ct-image" srcset="" sizes="(max-width: 1px) 100vw, 1px" /><div id="text_block-456-191" class="ct-text-block" >Szállítási díjkalkulátor</div></div></div></div></div></section><section id="section-13-191" class=" ct-section" ><div class="ct-section-inner-wrap"><div id="text_block-27-191" class="ct-text-block prod-single-content" ><span id="span-28-191" class="ct-span oxy-stock-content-styles" ><h2 class="font-black font-titan max-w-[660px] mx-auto mb-[24px] lg:mb-[40px] text-24 lg:text-32" style="text-align: center;">Figyelem!</h2>
<p class="text-16 lg:text-20 leading-[24px] lg:leading-[28px] font-light" style="text-align: center;">Friss gyümölcsöt csak saját futárainkkal tudjuk szállítani, Express One futárszolgálattal sajnos nem.</p>
</span></div><div id="div_block-32-191" class="ct-div-block" ></div></div></section>            <div tabindex="-1" class="oxy-modal-backdrop top "
