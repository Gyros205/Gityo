            <div class="mhcookie-header">
                                    <div class="mhcookie-dialog-logo-wrapper">
                        <img id="mhcookie-dialog-logo" src="https://simongyumolcs.hu/wp-content/uploads/2025/02/logo.svg" alt="Site logo">
